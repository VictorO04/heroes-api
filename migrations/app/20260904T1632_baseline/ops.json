  {
    "id": "unique.hero.hero_name_key",
    "label": "Add unique constraint on \"hero\" (name)",
    "operationClass": "additive",
    "target": {
      "id": "postgres",
      "details": {
        "schema": "public",
        "objectType": "unique",
        "name": "hero_name_key",
        "table": "hero"
      }
    },
    "precheck": [
      {
        "description": "ensure constraint \"hero_name_key\" does not exist",
        "sql": "SELECT NOT EXISTS (SELECT 1 AS \"one\" FROM \"pg_constraint\" AS \"c\" INNER JOIN \"pg_namespace\" AS \"n\" ON \"n\".\"oid\" = \"c\".\"connamespace\" WHERE (\"c\".\"conname\" = $1 AND \"n\".\"nspname\" = $2 AND \"c\".\"conrelid\" = to_regclass($3))) AS \"result\"",
        "params": [
          "hero_name_key",
          "public",
          "\"public\".\"hero\""
        ]
      }
    ],
    "execute": [
      {
        "description": "add unique constraint \"hero_name_key\"",
        "sql": "ALTER TABLE \"public\".\"hero\" ADD CONSTRAINT \"hero_name_key\" UNIQUE (\"name\")"
      }
    ],
    "postcheck": [
      {
        "description": "verify constraint \"hero_name_key\" exists",
        "sql": "SELECT EXISTS (SELECT 1 AS \"one\" FROM \"pg_constraint\" AS \"c\" INNER JOIN \"pg_namespace\" AS \"n\" ON \"n\".\"oid\" = \"c\".\"connamespace\" WHERE (\"c\".\"conname\" = $1 AND \"n\".\"nspname\" = $2 AND \"c\".\"conrelid\" = to_regclass($3))) AS \"result\"",
        "params": [
          "hero_name_key",
          "public",
          "\"public\".\"hero\""
        ]
